{
  "experiment_id": "exp7_qwen",
  "description": "Replication of Experiment 7 (prereg/replication_qwen.md) with Qwen3.5-4B; identical conditions.",
  "items": "datasets/cep_v2/items.jsonl",
  "R": 5,
  "peer_prompt": "peer_v1",
  "layer0": {
    "A": "outputs/layer0_qwen/layer0_qwen-run1__qwen35-4b-A.jsonl",
    "B": "outputs/layer0_qwen/layer0_qwen-run1__qwen35-4b-B.jsonl"
  },
  "conditions": [
    {
      "name": "seq_steps",
      "receiver": "configs/agents/qwen35_4b_B.json",
      "sender": "A",
      "show": "steps"
    },
    {
      "name": "seq_answer",
      "receiver": "configs/agents/qwen35_4b_B.json",
      "sender": "A",
      "show": "answer"
    },
    {
      "name": "random_answer",
      "receiver": "configs/agents/qwen35_4b_B.json",
      "sender": "random",
      "show": "answer"
    },
    {
      "name": "seq_steps_rev",
      "receiver": "configs/agents/qwen35_4b_A.json",
      "sender": "B",
      "show": "steps"
    }
  ],
  "backend": "vllm",
  "batch_size": 512,
  "out_dir": "outputs/exp7_qwen"
}