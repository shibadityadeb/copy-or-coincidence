{
  "experiment_id": "exp7b_olmo",
  "description": "Experiment 7b (prereg/exp7b_peer_v2.md): identical to exp7_olmo except the peer message ends with 'Give your final answer to the problem above.' (peer_v2).",
  "items": "datasets/cep_v2/items.jsonl",
  "R": 5,
  "peer_prompt": "peer_v2",
  "layer0": {
    "A": "outputs/layer0_olmo/layer0_olmo-run1__olmo3-7b-A.jsonl",
    "B": "outputs/layer0_olmo/layer0_olmo-run1__olmo3-7b-B.jsonl"
  },
  "conditions": [
    {
      "name": "seq_steps",
      "receiver": "configs/agents/olmo3_7b_B.json",
      "sender": "A",
      "show": "steps"
    },
    {
      "name": "seq_answer",
      "receiver": "configs/agents/olmo3_7b_B.json",
      "sender": "A",
      "show": "answer"
    },
    {
      "name": "random_answer",
      "receiver": "configs/agents/olmo3_7b_B.json",
      "sender": "random",
      "show": "answer"
    },
    {
      "name": "seq_steps_rev",
      "receiver": "configs/agents/olmo3_7b_A.json",
      "sender": "B",
      "show": "steps"
    }
  ],
  "backend": "vllm",
  "batch_size": 512,
  "out_dir": "outputs/exp7b_olmo"
}